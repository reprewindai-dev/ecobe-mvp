{
  "name": "ecobe-mvp",
  "version": "1.0.0",
  "description": "Customer-facing governance control plane for ECOBE",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:mcp",
    "build:mcp": "esbuild src/cli/co2router-mcp.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/co2router-mcp.mjs --banner:js=\"#!/usr/bin/env node\"",
    "start": "next start",
    "start:production": "node scripts/start-production.mjs",
    "test": "tsx --test src/__tests__/*.test.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "lint": "next lint",
    "type-check": "tsc --noEmit --project tsconfig.typecheck.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "happy-path": "node scripts/happy-path.mjs",
    "e2e:local": "node scripts/e2e-local.mjs",
    "e2e:providers": "node scripts/e2e-providers.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/client": "^6.19.2",
    "@types/express": "^5.0.3",
    "@types/node": "^20.11.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@x402/core": "^2.13.0",
    "@x402/evm": "^2.13.0",
    "@x402/extensions": "^2.13.0",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.0",
    "eslint-config-next": "16.3.0",
    "express": "^4.22.2",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "postcss": "^8.5.11",
    "prisma": "^6.19.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^20.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "embedded-postgres": "^18.3.0-beta.16",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "tsx": "^4.23.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "co2router-mcp": "dist/co2router-mcp.mjs"
  }
}
